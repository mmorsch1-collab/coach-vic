# ===== Coach Vic service config =====
# Copy to .env and fill in. Never commit .env.

# --- Anthropic (API key â€” NOT a Max subscription; automated agents on
#     subscription auth are disallowed and bill at API rates anyway) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model routing (mirrors the old openclaw.json):
COACH_MODEL_PRIMARY=claude-haiku-4-5
COACH_MODEL_HEAVY=claude-sonnet-4-6

# --- Telegram (reuse the existing Coach Vic bot for cutover; use a THROWAWAY
#     bot here for pre-swap testing so it doesn't fight the live bot for getUpdates) ---
TELEGRAM_BOT_TOKEN=123456:ABC...
# Only this chat id is served (single-user). Matt's id:
TELEGRAM_CHAT_ID=8062247102

# --- Bridge API (the OAuth/data layer; keep it running) ---
BRIDGE_URL=http://127.0.0.1:3000

# --- Behavior ---
TZ=America/New_York
# Master switch for proactive/scheduled messages (chat always works):
PROACTIVE_ENABLED=true
# Quiet hours (no proactive messages); inclusive start, exclusive end, local time:
QUIET_HOURS_START=21
QUIET_HOURS_END=6
# Max proactive messages per day and min minutes between same-type nudges:
MAX_PROACTIVE_PER_DAY=5
NUDGE_COOLDOWN_MINUTES=180

# --- Memory ---
# Where the brain/memory markdown lives (absolute path recommended):
WORKSPACE_DIR=C:\Users\gelin\coach-vic-github\coach-service\workspace
# Where operational state (queue, dedup, scheduler, daily counters) lives:
STATE_DIR=C:\dev\coach-data\state
# Retrieval mode: "keyword" (zero-dep, default, reliable) or "semantic"
# (requires optionally installing @xenova/transformers; falls back to keyword):
RETRIEVAL_MODE=keyword

# --- Logging ---
LOG_LEVEL=info

# Workout start time (HH:MM, 24h). Default 05:30. Shifts the calendar block + morning rhythm.
WORKOUT_TIME=05:30
