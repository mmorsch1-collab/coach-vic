{
  "name": "coach-vic-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coach Vic v2 — self-owned Telegram health-coach service (replaces OpenClaw gateway). Two-way chat + proactive coaching, powered by Claude via the Anthropic API, on top of the Bridge API.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "ritual": "tsx src/scripts/runRitual.ts",
    "chat": "tsx src/scripts/replayChat.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backlog": "tsx src/scripts/backlog.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
